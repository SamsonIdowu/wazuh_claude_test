# Terraform files
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
.terraform/
.terraform.lock.hcl

# SSH Keys
*.pem
*.pub
wazuh-test-key*
!*.pem.example

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
tfplan

# Test outputs (results are committed but logs aren't)
Results/*.log
Results/execution-log.txt

# Local configuration
.env
.env.local
*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class

# AWS credentials
.aws/credentials
.aws/config

# Credentials and secrets captured during test runs.
# A generated results file once held a live Slack bot token and Shuffle API key
# in plaintext; these patterns keep that out of git. Never commit real tokens.
**/INTEGRATION_CREDENTIALS.md
**/*credentials*.md
**/*CREDENTIALS*.md
**/*secret*
**/*SECRET*
**/*_api_key*
**/*apikey*
**/wazuh-passwords.txt
**/wazuh-install-files*
Results/credentials/
results/credentials/

# All deployment outputs (credentials, DNS, IPs, cert paths) for a test run -
# written once per run, deleted at teardown. Never committed.
results/deployment-outputs.md
Results/deployment-outputs.md
results/credentials/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Node modules (if any)
node_modules/

# Compiled outputs (if any)
dist/
build/

# macOS
.AppleDouble
.LSOverride
._*

# Windows
$RECYCLE.BIN/
ehthumbs.db

# Claude Code local overrides (may contain approved command strings)
.claude/settings.local.json
