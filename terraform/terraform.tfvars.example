# AWS Credentials - Read from local file
# Create a file at ~/.aws/credentials with your AWS access key and secret key
# Example format:
# [default]
# aws_access_key_id = YOUR_ACCESS_KEY
# aws_secret_access_key = YOUR_SECRET_KEY
#
# Then uncomment and set the variables below:

# aws_access_key = file("~/.aws/credentials")  # This needs to be parsed manually
# aws_secret_key = ""

# OR use a custom credentials file:
# aws_access_key = file("/path/to/your/credentials/file/access_key.txt")
# aws_secret_key = file("/path/to/your/credentials/file/secret_key.txt")

# Instance Configuration
aws_region      = "us-east-1"
instance_name   = "wazuh-4-14-6-instance"
instance_type   = "t3.xlarge"
root_volume_size = 30
wazuh_version   = "4.14.6"

# Networking
associate_public_ip = true

# Security - IMPORTANT: Restrict these CIDR blocks for production
allowed_ssh_cidrs      = ["0.0.0.0/0"]  # WARNING: Change to your IP for security
allowed_api_cidrs      = ["0.0.0.0/0"]  # WARNING: Change to your IP for security
allowed_agent_cidrs    = ["0.0.0.0/0"]
allowed_cluster_cidrs  = ["0.0.0.0/0"]

# SSH Key Output Path
ssh_key_output_path = "."

# Environment
environment = "testing"

# Auto-Destruction TTL (in minutes)
# Instance will automatically destroy itself after this time if terraform destroy is not run manually
# Default: 120 minutes (2 hours)
instance_ttl_minutes = 120
